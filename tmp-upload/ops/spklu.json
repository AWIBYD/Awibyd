);background:var(--p2);color:var(--dm);font:600 13px/1 inherit;padding:9px 13px;border-radius:99px;cursor:pointer;font-family:inherit}\n.spk .chip.on{background:var(--ac);border-color:var(--ac);color:#04140F}\n.spk .chip.me{border-color:var(--bl);color:var(--bl)}\n.spk .mapw{position:relative;border:1px solid var(--ln);border-radius:16px;overflow:hidden;background:#0D1728}\n.spk #spkmap{height:440px;width:100%}\n.spk .leg{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--dm);margin-top:10px}\n.spk .leg i{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:5px;vertical-align:-1px}\n.spk .cnt{font-size:13px;color:var(--dm);margin:16px 0 10px}\n.spk .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.spk .card{background:var(--p);border:1px solid var(--ln);border-radius:14px;padding:14px;min-width:0;display:flex;flex-direction:column;gap:8px}\n.spk .card.dl{border-color:var(--am);box-shadow:0 0 0 1px rgba(255,176,32,.25) inset}\n.spk .card .top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}\n.spk .card h3{overflow-wrap:anywhere}\n.spk .card .ad{font-size:12.5px;color:var(--dm);overflow-wrap:anywhere}\n.spk .tg{font-size:11px;font-weight:700;padding:4px 8px;border-radius:99px;white-space:nowrap}\n.spk .t-u{background:rgba(61,255,193,.14);color:var(--ac)}\n.spk .t-f{background:rgba(90,169,255,.15);color:var(--bl)}\n.spk .t-m{background:rgba(255,176,32,.15);color:var(--am)}\n.spk .t-a{background:rgba(147,163,192,.15);color:#C3CEE2}\n.spk .cn{display:flex;flex-wrap:wrap;gap:6px}\n.spk .cn span{font-size:11.5px;background:var(--p2);border:1px solid var(--ln);padding:3px 7px;border-radius:7px;color:#C9D4E8}\n.spk .cn span.x{opacity:.55;text-decoration:line-through}\n.spk .act{display:flex;gap:8px;margin-top:auto;padding-top:4px}\n.spk .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;font-weight:700;font-size:13px;padding:10px 12px;border-radius:10px;border:1px solid var(--ln);color:var(--tx);background:var(--p2);flex:1;text-align:center}\n.spk .btn.wa{background:#25D366;border-color:#25D366;color:#05210F}\n.spk .btn.big{flex:none;padding:14px 18px;font-size:15px}\n.spk .dist{font-size:12px;color:var(--bl);font-weight:700}\n.spk .box{background:var(--p);border:1px solid var(--ln);border-radius:16px;padding:18px}\n.spk .two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}\n.spk label{display:block;font-size:12px;color:var(--dm);margin:0 0 6px;font-weight:600}\n.spk select{width:100%;background:var(--p2);border:1px solid var(--ln);color:var(--tx);padding:12px;border-radius:10px;font-size:14.5px;font-family:inherit;-webkit-appearance:none;appearance:none;margin:0 0 12px}\n.spk .res{background:var(--p2);border:1px dashed var(--ln);border-radius:12px;padding:14px;font-size:14px}\n.spk .res b{color:var(--ac)}\n.spk .bar{height:10px;background:#1A2740;border-radius:99px;overflow:hidden;margin:10px 0 4px}\n.spk .bar i{display:block;height:100%;background:linear-gradient(90deg,var(--ac),#2BC8FF);border-radius:99px;transition:width .3s}\n.spk .bar.warn i{background:linear-gradient(90deg,var(--am),var(--rd))}\n.spk .cost{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n.spk .cost div{background:var(--p2);border:1px solid var(--ln);border-radius:12px;padding:12px;min-width:0}\n.spk .cost b{display:block;font-size:19px;font-family:\"Space Grotesk\",sans-serif;overflow-wrap:anywhere}\n.spk .cost span{font-size:12px;color:var(--dm)}\n.spk .cost .h b{color:var(--ac)}.spk .cost .s b{color:var(--bl)}.spk .cost .g b{color:var(--rd)}\n.spk .note{font-size:12px;color:var(--dm);margin-top:10px}\n.spk details{background:var(--p);border:1px solid var(--ln);border-radius:12px;margin-bottom:8px}\n.spk summary{cursor:pointer;padding:14px 16px;font-weight:700;font-size:14.5px;list-style:none}\n.spk summary::-webkit-details-marker{display:none}\n.spk summary:after{content:\"+\";float:right;color:var(--ac);font-size:18px;line-height:1}\n.spk details[open] summary:after{content:\"–\"}\n.spk details p{padding:0 16px 14px;color:#C9D4E8;font-size:14px}\n.spk .cta{text-align:center;background:linear-gradient(140deg,#123B33,#0F1D35);border:1px solid var(--acd);border-radius:18px;padding:24px 16px}\n.spk .cta p{color:var(--dm);margin:8px auto 16px;max-width:560px;font-size:14px}\n.spk .cta .row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}\n.spk .src{font-size:11.5px;color:#7385A5;margin-top:22px}\n.spk .leaflet-popup-content-wrapper,.spk .leaflet-popup-tip{background:#101B30;color:#E9EEF7}\n.spk .leaflet-popup-content{margin:12px 14px;font-size:13px;line-height:1.45}\n.spk .leaflet-popup-content b{color:#3DFFC1}\n.spk .leaflet-container a.leaflet-popup-close-button{color:#93A3C0}\n@media(max-width:760px){.spk .kpi{grid-template-columns:repeat(2,minmax(0,1fr))}.spk .grid,.spk .two{grid-template-columns:minmax(0,1fr)}.spk #spkmap{height:360px}.spk .cost b{font-size:16px}}\n@media(max-width:400px){.spk .cost{grid-template-columns:minmax(0,1fr)}}\n</style>\n\n<span class=\"eyb\">⚡ Data diperbarui 12 November 2026</span>\n<h1>Peta SPKLU Makassar 2026: Lokasi, Tipe Charger &amp; Biaya Cas</h1>\n<p class=\"lead\">Semua titik pengisian mobil listrik umum di Makassar, Gowa, Maros sampai jalur Parepare–Pinrang. Lengkap dengan daya charger, jenis colokan, tombol rute, dan hitungan biaya cas.</p>\n<div class=\"kpi\">\n<div><b id=\"k1\">–</b><span>titik SPKLU di peta</span></div>\n<div><b id=\"k2\">–</b><span>titik di Kota Makassar</span></div>\n<div><b id=\"k3\">–</b><span>titik fast charging DC ≥50 kW</span></div>\n<div><b>180 kW</b><span>daya tertinggi (PLN Karebosi, Hertasning, Maros, Parepare)</span></div>\n</div>\n\n<section id=\"peta\">\n<h2>Cari SPKLU terdekat</h2>\n<p class=\"sub\">Ketuk titik di peta untuk detail &amp; rute. Warna menunjukkan kecepatan charger.</p>\n<div class=\"chips\" id=\"spkf\">\n<button class=\"chip on\" data-f=\"all\">Semua</button>\n<button class=\"chip\" data-f=\"u\">Ultra Fast ≥100 kW</button>\n<button class=\"chip\" data-f=\"f\">Semua DC</button>\n<button class=\"chip\" data-f=\"a\">AC (sambil parkir)</button>\n<button class=\"chip\" data-f=\"r:mks\">Kota Makassar</button>\n<button class=\"chip\" data-f=\"r:gt\">Gowa–Takalar</button>\n<button class=\"chip\" data-f=\"r:mp\">Maros–Pangkep</button>\n<button class=\"chip\" data-f=\"r:pp\">Parepare–Pinrang–Sidrap</button>\n<button class=\"chip me\" id=\"spkme\">📍 Terdekat dari saya</button>\n</div>\n<div class=\"mapw\"><div id=\"spkmap\" role=\"region\" aria-label=\"Peta SPKLU Makassar\"></div></div>\n<div class=\"leg\"><span><i style=\"background:#3DFFC1\"></i>Ultra Fast DC ≥100 kW</span><span><i style=\"background:#5AA9FF\"></i>Fast DC 50–99 kW</span><span><i style=\"background:#FFB020\"></i>DC 25–49 kW</span><span><i style=\"background:#93A3C0\"></i>AC 7–22 kW</span><span><i style=\"background:#FF5DA2\"></i>Showroom BYD Haka Karebosi</span></div>\n<p class=\"cnt\" id=\"spkcnt\"></p>\n<div class=\"grid\" id=\"spkl\"></div>\n</section>\n\n<section id=\"rute\">\n<h2>Rute luar kota: cukup sekali cas?</h2>\n<p class=\"sub\">Pilih mobil dan tujuan. Hitungan memakai jarak tempuh nyata ±80% dari angka resmi (AC menyala, muatan penuh, jalan menanjak).</p>\n<div class=\"box two\">\n<div><label for=\"spkrm\">Mobil BYD / Denza</label><select id=\"spkrm\"></select><label for=\"spkrr\">Tujuan dari Makassar</label><select id=\"spkrr\"></select></div>\n<div class=\"res\" id=\"spkrres\"></div>\n</div>\n</section>\n\n<section id=\"biaya\">\n<h2>Cas di rumah vs SPKLU vs bensin</h2>\n<p class=\"sub\">Kebanyakan pemilik mobil listrik cas di rumah malam hari. SPKLU dipakai saat perjalanan jauh.</p>\n<div class=\"box\">\n<label for=\"spkcm\">Pilih model</label><select id=\"spkcm\"></select>\n<div class=\"cost\">\n<div class=\"h\"><span>Cas penuh di rumah</span><b id=\"c1\">–</b><span>±Rp1.700/kWh</span></div>\n<div class=\"s\"><span>Cas penuh di SPKLU</span><b id=\"c2\">–</b><span>mulai ±Rp2.467/kWh</span></div>\n<div class=\"g\"><span>Bensin jarak sama</span><b id=\"c3\">–</b><span>Pertamax Rp16.300/L, 10 km/L</span></div>\n</div>\n<p class=\"note\" id=\"c4\"></p>\n<p class=\"note\">Tarif SPKLU fast charging bisa ditambah biaya layanan, cek tarif terbaru di aplikasi PLN Mobile. Hitung lebih detail di <a href=\"https://byd-makassar.id/kalkulator-charging-byd/\">Kalkulator Charging BYD</a> dan <a href=\"https://byd-makassar.id/kalkulator-hemat/\">Kalkulator Hemat</a>.</p>\n</div>\n</section>\n\n<section id=\"faq\">\n<h2>Pertanyaan yang sering ditanyakan</h2>\n<div style=\"margin-top:12px\">\n<details><summary>Berapa biaya cas mobil listrik di SPKLU Makassar?</summary><p>Tarif dasar SPKLU PLN tercatat sekitar Rp2.467 per kWh. Untuk fast charging bisa ada tambahan biaya layanan. Contoh: mengisi 30 kWh di SPKLU sekitar Rp74 ribu. Cek tarif terbaru langsung di aplikasi PLN Mobile sebelum mengisi.</p></details>\n<details><summary>Apakah semua SPKLU bisa dipakai mobil BYD?</summary><p>Mobil BYD di Indonesia memakai colokan CCS2 untuk fast charging DC dan Type 2 untuk AC. Hampir semua SPKLU PLN menyediakan keduanya. Colokan CHAdeMO tidak cocok untuk BYD, jadi di peta kami tandai dicoret.</p></details>\n<details><summary>Berapa lama mengisi daya di SPKLU fast charging?</summary><p>Tergantung kemampuan mobil, bukan cuma charger. Contoh BYD Atto 1 Premium (DC maks 40 kW): 20% ke 80% sekitar 35 menit. Model dengan DC lebih besar seperti Sealion 7 (150 kW) bisa lebih cepat. Charger AC 22 kW cocok untuk mengisi sambil kerja, belanja, atau makan.</p></details>\n<details><summary>Lebih hemat cas di rumah atau di SPKLU?</summary><p>Di rumah lebih hemat, sekitar Rp1.700 per kWh untuk tarif rumah tangga non-subsidi, dibanding SPKLU mulai Rp2.467 per kWh. Pola paling praktis: cas di rumah malam hari, SPKLU hanya untuk perjalanan luar kota.</p></details>\n<details><summary>Aman tidak bawa mobil listrik ke Toraja atau Palopo?</summary><p>Aman dengan rencana cas. Jalur Makassar–Parepare–Pinrang punya SPKLU fast charging 180 kW di Maros, Parepare, dan Pinrang. Palopo juga sudah punya SPKLU fast charging. Gunakan simulasi rute di atas, atau konsultasikan rute Anda dengan sales kami.</p></details>\n<details><summary>Bagaimana cara pasang charger di rumah?</summary><p>Yang perlu dicek: daya listrik rumah, jarak panel ke garasi, dan jenis charger. Konsultasikan dengan sales BYD Haka Karebosi via WhatsApp, kami bantu hitungkan kebutuhan daya dan biayanya.</p></details>\n</div>\n</section>\n\n<section>\n<div class=\"cta\">\n<h2>Masih ragu soal charging?</h2>\n<p>Kirim lokasi rumah dan rute harian Anda. Sales kami hitungkan pola cas paling hemat, plus jadwalkan test drive dan coba langsung SPKLU di showroom.</p>\n<div class=\"row\">\n<a class=\"btn wa big\" id=\"spkw1\" href=\"#\" rel=\"noopener\">💬 Konsultasi Charging via WA</a>\n<a class=\"btn big\" id=\"spkw2\" href=\"#\" rel=\"noopener\">🚗 Jadwalkan Test Drive</a>\n</div>\n<p style=\"margin:14px auto 0;font-size:13px\">BYD Haka Karebosi · Jl. Ahmad Yani No. 15 Makassar · WA 0822-5945-2349<br>Senin–Sabtu 08.00–17.00, Minggu 09.00–17.00 WITA</p>\n</div>\n<p class=\"src\">Sumber data lokasi: <a href=\"https://openchargemap.org/\" rel=\"nofollow noopener\">Open Charge Map</a> (CC BY 4.0) dan rilis PLN UID Sulselrabar, dirangkum 12 November 2026. Status ketersediaan bisa berubah, selalu cek status realtime di aplikasi PLN Mobile sebelum berangkat. Peta © kontributor OpenStreetMap.</p>\n</section>\n\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Berapa biaya cas mobil listrik di SPKLU Makassar?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tarif dasar SPKLU PLN tercatat sekitar Rp2.467 per kWh. Untuk fast charging bisa ada tambahan biaya layanan. Cek tarif terbaru di aplikasi PLN Mobile.\"}},{\"@type\":\"Question\",\"name\":\"Apakah semua SPKLU bisa dipakai mobil BYD?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Mobil BYD di Indonesia memakai colokan CCS2 untuk fast charging DC dan Type 2 untuk AC. Colokan CHAdeMO tidak cocok untuk BYD.\"}},{\"@type\":\"Question\",\"name\":\"Berapa lama mengisi daya di SPKLU fast charging?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tergantung kemampuan mobil. Contoh BYD Atto 1 Premium (DC maks 40 kW): 20% ke 80% sekitar 35 menit.\"}},{\"@type\":\"Question\",\"name\":\"Lebih hemat cas di rumah atau di SPKLU?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Di rumah lebih hemat, sekitar Rp1.700 per kWh dibanding SPKLU mulai Rp2.467 per kWh.\"}},{\"@type\":\"Question\",\"name\":\"Aman tidak bawa mobil listrik ke Toraja atau Palopo?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Aman dengan rencana cas. Jalur Makassar–Parepare–Pinrang punya SPKLU fast charging 180 kW di Maros, Parepare, dan Pinrang, dan Palopo juga sudah punya SPKLU fast charging.\"}},{\"@type\":\"Question\",\"name\":\"Bagaimana cara pasang charger di rumah?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cek daya listrik rumah, jarak panel ke garasi, dan jenis charger. Konsultasikan dengan sales BYD Haka Karebosi via WhatsApp 0822-5945-2349.\"}}]}</script>\n\n<script>\n(function(){\nvar R=document.getElementById('spk');if(!R||R.dataset.init)return;R.dataset.init='1';\nvar WA='6282259452349';\n/* [nama, alamat, lat, lng, region, operator, konektor [[tipe,kW,jumlah]], showroom?] tipe: C=CCS2 DC, H=CHAdeMO, A=Type2 AC */\nvar S=[\n['BYD Haka Auto Karebosi','Jl. Ahmad Yani No. 15, Makassar',-5.132939,119.409387,'mks','Voltron',[['C',60,2]],1],\n['PLN ULP Karebosi','Jl. Jend. Ahmad Yani, Makassar',-5.132681,119.410701,'mks','PLN',[['C',180,2],['C',100,2]]],\n['Balai Kota Makassar','Jl. Jend. Ahmad Yani, Makassar',-5.133071,119.408097,'mks','PLN',[['C',180,2]]],\n['PLN ULP Makassar Utara','Jl. Gunung Latimojong, Makassar',-5.132096,119.419134,'mks','PLN',[['A',22,1]]],\n['PLN ULP