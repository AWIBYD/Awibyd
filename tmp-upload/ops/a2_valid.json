[{"label": "a2-update", "method": "POST", "path": "wp/v2/model/10694", "body": {"content": "<div style=\"display:inline-block;margin:24px 0 8px;padding:6px 14px;border-radius:999px;background:#fff4d6;color:#7a5a00;font-size:13px;font-weight:700;letter-spacing:1px\">SEGERA HADIR · INDEN DIBUKA</div>\n<h2 style=\"margin:0 0 10px;font-size:30px;line-height:1.3;color:#111111\">BYD Atto 2: SUV Listrik 5 Penumpang, Hingga 510 km, Inden di Makassar</h2>\n<figure style=\"margin:0 0 14px\"><img src=\"https://byd-makassar.id/wp-content/uploads/2026/10/byd-atto-2-hero.webp\" alt=\"BYD Atto 2 SUV listrik 5 penumpang, inden dibuka di BYD Haka Karebosi Makassar\" width=\"1400\" height=\"969\" loading=\"eager\" fetchpriority=\"high\" style=\"display:block;width:100%;height:auto;border-radius:10px;margin:0 0 6px\" /></figure>\n<p style=\"margin:0 0 14px;line-height:1.75;color:#333;font-size:16px\"><strong>BYD Atto 2</strong> adalah SUV listrik 5 penumpang dengan jarak tempuh <strong>hingga 510 km sekali isi daya</strong> (NEDC). Pakai <strong>Blade Battery 2.0</strong> berkapasitas 57,9 kWh yang awet dan aman, desain SUV yang nyaman, dan kabin yang tetap lega untuk seluruh keluarga. Tersedia dalam dua tipe: <strong>Dynamic</strong> dan <strong>Premium</strong>.</p>\n<p style=\"margin:0 0 14px;line-height:1.75;color:#333;font-size:16px\">Harga resmi Indonesia <strong>diumumkan saat peluncuran</strong>. Inden sudah bisa lewat dealer resmi BYD Haka Karebosi Makassar, Jl. Ahmad Yani No. 15. Daftar sekarang supaya dapat antrean unit lebih awal dan dikabari pertama saat harga keluar.</p>\n<div style=\"display:flex;flex-wrap:wrap;gap:12px;margin:6px 0 16px\"><div style=\"flex:1 1 140px;padding:14px;border:1px solid #d9e6cf;border-radius:10px;background:#f5f9f1\"><div style=\"font-size:24px;font-weight:800;color:#4f7a3a;line-height:1.2\">510 km</div><div style=\"font-size:14px;font-weight:600;color:#111\">Jarak tempuh EV</div><div style=\"font-size:12px;color:#777\">Standar NEDC</div></div><div style=\"flex:1 1 140px;padding:14px;border:1px solid #d9e6cf;border-radius:10px;background:#f5f9f1\"><div style=\"font-size:24px;font-weight:800;color:#4f7a3a;line-height:1.2\">57,9 kWh</div><div style=\"font-size:14px;font-weight:600;color:#111\">Blade Battery 2.0</div><div style=\"font-size:12px;color:#777\">Generasi kedua</div></div><div style=\"flex:1 1 140px;padding:14px;border:1px solid #d9e6cf;border-radius:10px;background:#f5f9f1\"><div style=\"font-size:24px;font-weight:800;color:#4f7a3a;line-height:1.2\">130 kW</div><div style=\"font-size:14px;font-weight:600;color:#111\">Daya motor</div><div style=\"font-size:12px;color:#777\">Torsi 205 N·m</div></div><div style=\"flex:1 1 140px;padding:14px;border:1px solid #d9e6cf;border-radius:10px;background:#f5f9f1\"><div style=\"font-size:24px;font-weight:800;color:#4f7a3a;line-height:1.2\">8 tahun</div><div style=\"font-size:14px;font-weight:600;color:#111\">Garansi baterai & motor</div><div style=\"font-size:12px;color:#777\">Power battery & motor listrik, 160.000 km</div></div></div>\n<a href=\"https://wa.me/6282259452349?text=Halo%20Kak%20AWI%2C%20saya%20mau%20inden%20BYD%20Atto%202%20di%20Makassar.%20Mohon%20info%20cara%20booking%20dan%20estimasi%20harganya.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#16a34a;color:#fff;padding:13px 22px;border-radius:8px;text-decoration:none;font-weight:600;margin:0 10px 10px 0\">Inden BYD Atto 2 via WhatsApp</a><a href=\"https://wa.me/6282259452349?text=Halo%20Kak%20AWI%2C%20saya%20lihat%20halaman%20BYD%20Atto%202.%20Mau%20dikabari%20duluan%20saat%20harga%20resmi%20keluar.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#111111;color:#fff;padding:13px 22px;border-radius:8px;text-decoration:none;font-weight:600;margin:0 10px 10px 0\">Kabari Saya Saat Harga Keluar</a>\n<p style=\"margin:40px 0 4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#4f7a3a;font-weight:700\">Pilihan Tipe</p><h2 style=\"margin:0 0 10px;font-size:26px;line-height:1.3;color:#111111\">Dynamic atau Premium?</h2>\n<div style=\"display:flex;flex-wrap:wrap;gap:12px;margin:0 0 14px\"><div style=\"flex:1 1 260px;min-width:0;padding:16px 18px;border-radius:12px;background:#f8fafc;border:1px solid #e2e8f0\"><p style=\"margin:0 0 8px;font-size:20px;font-weight:800;color:#111;letter-spacing:.5px\">DYNAMIC</p><ul style=\"margin:0;padding-left:18px;font-size:15px;line-height:1.6;color:#333\"><li style=\"margin:0 0 5px\">Jok fabric</li><li style=\"margin:0 0 5px\">Kamera belakang</li><li style=\"margin:0 0 5px\">Radar 4 belakang</li><li style=\"margin:0 0 5px\">ADAS (tanpa RCW &amp; BSD)</li><li style=\"margin:0 0 5px\">4 speaker</li><li style=\"margin:0 0 5px\">Velg alloy R17</li></ul></div><div style=\"flex:1 1 260px;min-width:0;padding:16px 18px;border-radius:12px;background:#f5f9f1;border:1px solid #cfe3bf\"><p style=\"margin:0 0 8px;font-size:20px;font-weight:800;color:#111;letter-spacing:.5px\">PREMIUM</p><ul style=\"margin:0;padding-left:18px;font-size:15px;line-height:1.6;color:#333\"><li style=\"margin:0 0 5px\">Jok synthetic leather</li><li style=\"margin:0 0 5px\">Kamera 360</li><li style=\"margin:0 0 5px\">ADAS 13 fitur</li><li style=\"margin:0 0 5px\">Panoramic roof</li><li style=\"margin:0 0 5px\">Ventilated seat depan</li><li style=\"margin:0 0 5px\">Wireless charging 50W</li><li style=\"margin:0 0 5px\">8 speaker</li></ul></div></div>\n<p style=\"margin:0 0 14px;line-height:1.75;color:#333;font-size:16px\">Kedua tipe memakai baterai, motor, dan jarak tempuh yang sama (57,9 kWh, 130 kW, 510 km NEDC). Bedanya di kenyamanan kabin, kamera, dan fitur keselamatan. Bingung pilih yang mana? Chat AWI, nanti dibantu sesuai kebutuhan harian kamu.</p>\n<p style=\"margin:40px 0 4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#4f7a3a;font-weight:700\">Pilihan Warna</p><h2 style=\"margin:0 0 10px;font-size:26px;line-height:1.3;color:#111111\">3 Pilihan Warna BYD Atto 2</h2>\n<div style=\"display:flex;flex-wrap:wrap;gap:10px;margin:0 0 16px\"><div style=\"display:flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#fff;flex:1 1 160px\"><span style=\"display:inline-block;width:26px;height:26px;border-radius:50%;background:#111111;border:2px solid #444\"></span><strong style=\"font-size:15px;color:#111\">Cosmos Black</strong></div><div style=\"display:flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#fff;flex:1 1 160px\"><span style=\"display:inline-block;width:26px;height:26px;border-radius:50%;background:#f8f8f6;border:2px solid #bbb\"></span><strong style=\"font-size:15px;color:#111\">Ski White</strong></div><div style=\"display:flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid #e5e7eb;border-radius:10px;background:#fff;flex:1 1 160px\"><span style=\"display:inline-block;width:26px;height:26px;border-radius:50%;background:#7b8087;border:2px solid #666\"></span><strong style=\"font-size:15px;color:#111\">Harbour Grey</strong></div></div>\n<p style=\"margin:40px 0 4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#4f7a3a;font-weight:700\">Desain</p><h2 style=\"margin:0 0 10px;font-size:26px;line-height:1.3;color:#111111\">SUV Listrik dengan Karakter Modern</h2>\n<figure style=\"margin:0 0 14px\"><img src=\"https://byd-makassar.id/wp-content/uploads/2026/10/byd-atto-2-depan.webp\" alt=\"Tampak depan BYD Atto 2 SUV listrik\" width=\"1330\" height=\"540\" loading=\"lazy\" style=\"display:block;width:100%;height:auto;border-radius:10px;margin:0 0 6px\" /><figcaption style=\"font-size:14px;color:#555;line-height:1.5\"><strong>Desain SUV modern</strong> dengan lampu LED dan DRL tipis yang menyatu dengan grille.</figcaption></figure>\n<div style=\"display:flex;flex-wrap:wrap;gap:14px;margin:0 0 4px\"><div style=\"flex:1 1 260px;min-width:0\"><figure style=\"margin:0 0 14px\"><img src=\"https://byd-makassar.id/wp-content/uploads/2026/10/byd-atto-2-lampu-belakang.webp\" alt=\"Lampu belakang BYD Atto 2\" width=\"890\" height=\"310\" loading=\"lazy\" style=\"display:block;width:100%;height:auto;border-radius:10px;margin:0 0 6px\" /><figcaption style=\"font-size:14px;color:#555;line-height:1.5\"><strong>Lampu belakang menyambung</strong> dari sisi ke sisi.</figcaption></figure></div><div style=\"flex:1 1 260px;min-width:0\"><figure style=\"margin:0 0 14px\"><img src=\"https://byd-makassar.id/wp-content/uploads/2026/10/byd-atto-2-nfc-key.webp\" alt=\"NFC card dan digital key BYD Atto 2\" width=\"585\" height=\"310\" loading=\"lazy\" style=\"display:block;width:100%;height:auto;border-radius:10px;margin:0 0 6px\" /><figcaption style=\"font-size:14px;color:#555;line-height:1.5\"><strong>Multi access</strong>: keyless, NFC card, NFC digital key, dan Bluetooth.</figcaption></figure></div></div>\n<figure style=\"margin:0 0 14px\"><img src=\"https://byd-makassar.id/wp-content/uploads/2026/10/byd-atto-2-bagasi.webp\" alt=\"Bagasi BYD Atto 2 380 liter\" width=\"1400\" height=\"814\" loading=\"lazy\" style=\"display:block;width:100%;height:auto;border-radius:10px;margin:0 0 6px\" /><figcaption style=\"font-size:14px;color:#555;line-height:1.5\"><strong>Bagasi 380 L</strong>, bisa jadi 1.320 L saat kursi belakang dilipat.</figcaption></figure>\n<p style=\"margin:40px 0 4px;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#4f7a3a;font-weight:700\">Kabin & Teknologi</p><h2 style=\"margin:0 0 10px;font-size:26px;line-height:1.3;color:#111111\">Kabin Lega untuk Harian dan Keluarga</h2>\n<figure style=\"margin:0 0 14px\"><img src=\"https://byd-makassar.id/wp-content/uploads/2026/10/byd-atto-2-kokpit.webp\" alt=\"Headunit 12,8 inci dan MID cluster 8,8 inci BYD Atto 2\" width=\"1400\" height=\"507\" loading=\"lazy\" style=\"display:block;width:100%;height:auto;border-radius:10px;margin:0 0 6px\" /><figcaption style=\"font-size:14px;color:#555;line-height:1.5\"><st