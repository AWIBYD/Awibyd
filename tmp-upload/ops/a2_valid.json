;color:#555\">AC charging</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>7 kW</strong></td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;color:#555\">DC charging</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>BYD Flash (&gt;1 MW)</strong></td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;color:#555\">V2L</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>6,6 kW (adapter 3,3 kW)</strong></td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;color:#555\">Portable charging</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>2,2 kW</strong></td></tr><tr><td colspan=\"3\" style=\"padding:9px 12px;background:#eef5e8;color:#4f7a3a;font-weight:800;font-size:13px;letter-spacing:1px;text-transform:uppercase\">Chassis</td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;color:#555\">Arsitektur</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>Cell-to-Body (CTB)</strong></td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;color:#555\">Suspensi depan / belakang</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>MacPherson Strut / Five-link (multi-link)</strong></td></tr><tr><td style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;color:#555\">Rem depan / belakang</td><td colspan=\"2\" style=\"padding:9px 12px;border-bottom:1px solid #eee;vertical-align:top;text-align:center\"><strong>Ventilated Disc / Disc</strong></td></tr><tr><td style=\"